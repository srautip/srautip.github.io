<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SchoolTestRunner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimetableCore\TimetableCore.vbproj" />
  </ItemGroup>

  <!-- TimetableCore.Tests's RootNamespace ("TimetableCore.Tests") is
       lexically nested under "TimetableCore", so its files can reference
       JsonHelpers etc. unqualified without an explicit Imports statement.
       SchoolTestRunner's RootNamespace isn't nested that way, so it needs
       this supplied as a project-level global import instead - same
       reasoning as RobustnessRunner.vbproj. -->
  <ItemGroup>
    <Import Include="TimetableCore" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- Phase 2.21: die "Stundentafel"-HTML-Vorlage wird als Ressource in
       die Assembly eingebettet (statt per CopyToOutputDirectory kopiert),
       damit sie zur Laufzeit unabhaengig vom aktuellen Arbeitsverzeichnis
       ueber Assembly.GetManifestResourceStream lesbar ist. -->
  <ItemGroup>
    <EmbeddedResource Include="Templates\stundentafel.html" />
    <EmbeddedResource Include="Templates\klassenbildung.html" />
  </ItemGroup>

</Project>
