<Application x:Class="Application"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- MUSS das erste Kind sein. Die Geschwister darunter
                 duerfen dann per StaticResource hineingreifen, weil das
                 Dictionary zum Parse-Zeitpunkt schon geladen ist.
                 Die Styles bleiben bewusst HIER und wandern nicht in
                 eine zweite Datei: ein gemergtes Dictionary kann nicht
                 per StaticResource in ein Geschwister-Dictionary
                 greifen - das kostete sonst DynamicResource oder ein
                 doppeltes Laden der Tokens. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Design/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolNachSichtbar" />

            <!-- ============ Steuerelemente, minimal-invasiv ============
                 Grundsatz: Setter ja, ControlTemplate nur wo
                 unvermeidbar. Die Aero2-Vorlagen ehren manche
                 Eigenschaften per TemplateBinding und ueberschreiben
                 andere in ihren eigenen Triggern - das muss man pro
                 Steuerelement wissen, sonst baut man Styles, die beim
                 Darueberfahren zurueckspringen. -->

            <Style TargetType="Menu">
                <Setter Property="Background" Value="{StaticResource farbe-flaeche}" />
                <Setter Property="Foreground" Value="{StaticResource farbe-text}" />
                <Setter Property="FontSize" Value="{StaticResource grad-basis}" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="BorderBrush" Value="{StaticResource farbe-linie}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>

            <Style TargetType="StatusBar">
                <Setter Property="Background" Value="{StaticResource farbe-flaeche-2}" />
                <Setter Property="Foreground" Value="{StaticResource farbe-text-2}" />
                <Setter Property="FontSize" Value="{StaticResource grad-klein}" />
                <Setter Property="BorderBrush" Value="{StaticResource farbe-linie}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>

            <Style TargetType="StatusBarItem">
                <Setter Property="Padding" Value="8,3" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource farbe-flaeche}" />
                <Setter Property="Foreground" Value="{StaticResource farbe-text}" />
                <Setter Property="BorderBrush" Value="{StaticResource farbe-linie-stark}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="{StaticResource pad-feld}" />
                <Setter Property="FontSize" Value="{StaticResource grad-basis}" />
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{StaticResource farbe-flaeche}" />
                <Setter Property="Foreground" Value="{StaticResource farbe-text}" />
                <Setter Property="BorderBrush" Value="{StaticResource farbe-linie-stark}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="{StaticResource pad-feld}" />
                <Setter Property="FontSize" Value="{StaticResource grad-basis}" />
            </Style>

            <!-- Button: BEWUSST OHNE Background-Setter. Die
                 Aero2-Trigger ueberschreiben ihn bei Hover und
                 Pressed - ein Background-Setter zeigte sich nur im
                 Ruhezustand und "blitzte" beim Ueberfahren zurueck ins
                 Systemblau. Was zuverlaessig durchschlaegt, steht hier;
                 fuer die Primaeraktion gibt es darunter eine eigene
                 Vorlage. Nebeneffekt: die heute an fuenf Stellen
                 wiederholten Padding-Werte entfallen. -->
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource farbe-text}" />
                <Setter Property="FontSize" Value="{StaticResource grad-klein}" />
                <Setter Property="Padding" Value="{StaticResource pad-knopf}" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="MinWidth" Value="72" />
            </Style>

            <!-- Die einzige eigene Vorlage. Folgt dem Muster, das
                 BereichsSchalter unten schon benutzt: Border +
                 ContentPresenter + Trigger. -->
            <Style x:Key="KnopfPrimaer" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource farbe-flaeche}" />
                <Setter Property="FontSize" Value="{StaticResource grad-klein}" />
                <Setter Property="Padding" Value="{StaticResource pad-knopf}" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Rahmen"
                                    Background="{StaticResource farbe-akzent}"
                                    CornerRadius="{StaticResource radius-m}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource farbe-akzent-hover}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource farbe-text}" />
                                    <Setter TargetName="Rahmen" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource farbe-linie-stark}" />
                                    <Setter Property="Foreground" Value="{StaticResource farbe-text-3}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Seitenleiste ============ -->
            <Style x:Key="BereichsSchalter" TargetType="RadioButton">
                <Setter Property="GroupName" Value="Bereiche" />
                <Setter Property="Margin" Value="4,2" />
                <Setter Property="Padding" Value="4,8" />
                <Setter Property="Foreground" Value="{StaticResource farbe-text-2}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Rahmen" Background="Transparent"
                                    CornerRadius="{StaticResource radius-m}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource farbe-flaeche-3}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource farbe-akzent-flaeche}" />
                                    <Setter Property="Foreground" Value="{StaticResource farbe-akzent}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource farbe-akzent}" />
                                    <Setter TargetName="Rahmen" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BereichsIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource schrift-symbole}" />
                <Setter Property="FontSize" Value="{StaticResource grad-symbol}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="BereichsLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource grad-mikro}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>

            <!-- ============ Startseite: Schrittleiste ============ -->
            <!-- EIN Style fuer alle Schritte. Die Verwendung setzt den
                 DataContext auf die jeweilige SchrittStand-Eigenschaft,
                 dann vergleichen die Trigger direkt gegen {Binding} -
                 sonst braeuchte jeder Schritt seinen eigenen,
                 fast gleichen Style.
                 Zeichen UND Farbe wechseln gemeinsam: das ist dieselbe
                 Doppelkodierung, die das Konzept fuer die Ampel
                 verlangt (Farbe allein traegt nicht). -->
            <Style x:Key="SchrittZeichen" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource schrift-symbole}" />
                <Setter Property="FontSize" Value="{StaticResource grad-kopf}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="26" />
                <!-- Offen: Ring, neutral -->
                <Setter Property="Text" Value="&#xE91F;" />
                <Setter Property="Foreground" Value="{StaticResource farbe-text-3}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding}" Value="Bereit">
                        <Setter Property="Text" Value="&#xE768;" />
                        <Setter Property="Foreground" Value="{StaticResource farbe-akzent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Erledigt">
                        <Setter Property="Text" Value="&#xE73E;" />
                        <Setter Property="Foreground" Value="{StaticResource farbe-ok-text}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Warnung">
                        <Setter Property="Text" Value="&#xE7BA;" />
                        <Setter Property="Foreground" Value="{StaticResource farbe-warn-text}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SchrittTitel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource grad-kopf}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource farbe-text}" />
            </Style>

            <Style x:Key="SchrittText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource grad-basis}" />
                <Setter Property="Foreground" Value="{StaticResource farbe-text-2}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,8" />
            </Style>

            <Style x:Key="Marke" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource grad-titel}" />
                <Setter Property="Foreground" Value="{StaticResource farbe-text}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
