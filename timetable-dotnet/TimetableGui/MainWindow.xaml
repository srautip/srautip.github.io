<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:app="clr-namespace:TimetableGui"
        Title="{Binding Titel}" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource farbe-flaeche}"
        Foreground="{StaticResource farbe-text}"
        FontFamily="{StaticResource schrift-stapel}"
        FontSize="{StaticResource grad-basis}">

    <!-- Schrift und Grundfarben stehen HIER am Fenster, nicht als
         impliziter Style TargetType="Window": implizite Styles greifen
         auf den konkreten Typ, und MainWindow ist eine Ableitung -
         ein Window-Style wuerde sie stillschweigend verfehlen. Beide
         Eigenschaften vererben von hier nach unten und sind damit der
         billigste globale Hebel. -->

    <!-- Fensteraufbau nach gui-ui-konzept.md 2: EIN Hauptfenster,
         schmale Seitenleiste, der Rest gehoert dem Vollflaechen-Dashboard.
         Stammdaten- und Regel-Pflege laufen spaeter als modale Dialoge
         DARUEBER (Stufe F) - das Dashboard bleibt der Anker. -->
    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="Neues Projekt…" Command="{Binding NeuBefehl}" />
                <MenuItem Header="Bestehende Schule übernehmen…" Command="{Binding ImportierenBefehl}" />
                <MenuItem Header="Öffnen…" Command="{Binding OeffnenBefehl}" />
                <Separator />
                <MenuItem Header="Speichern" InputGestureText="Strg+S" Command="{Binding SpeichernBefehl}" />
                <Separator />
                <MenuItem Header="Beenden" Click="AufBeenden" />
            </MenuItem>
            <MenuItem Header="_Planung">
                <MenuItem Header="Klassenbildung rechnen" InputGestureText="F5" Command="{Binding KlassenbildungBefehl}" />
                <MenuItem Header="Stundenplan rechnen" InputGestureText="F6" Command="{Binding StundenplanBefehl}" />
                <MenuItem Header="Lauf abbrechen" Command="{Binding Monitor.AbbrechenBefehl}" />
            </MenuItem>
            <MenuItem Header="_Extras">
                <MenuItem Header="Stammdaten…" Click="AufStammdaten" />
                <MenuItem Header="Klassenbildung: Eingaben…" Click="AufKlassenbildungEingaben" />
                <MenuItem Header="Regeln…" Click="AufRegeln" />
                <Separator />
                <MenuItem Header="Klarnamen exportieren…" Click="AufKlarnamenExport" />
            <Separator />
            <MenuItem Header="Browserdaten bereinigen" Click="AufBrowserdatenBereinigen" />
            </MenuItem>
            <MenuItem Header="_Hilfe">
                <MenuItem Header="Über" Click="AufUeber" />
            </MenuItem>
        </Menu>

        <!-- Statusleiste: Meldung, laufender Lauf mit Kurzfortschritt und
             Abbrechen (Konzept 2). -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Meldung}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Monitor.StatusZeile}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ProgressBar Width="140" Height="6" Minimum="0" Maximum="100"
                                 VerticalAlignment="Center"
                                 Background="{StaticResource farbe-linie}"
                                 Foreground="{StaticResource farbe-akzent}"
                                 BorderThickness="0"
                                 Value="{Binding Monitor.FortschrittProzent, Mode=OneWay}"
                                 Visibility="{Binding Monitor.Laeuft, Converter={StaticResource BoolNachSichtbar}}" />
                    <Button Content="Abbrechen" Margin="8,0,0,0" MinHeight="22" MinWidth="0" Padding="8,2"
                            Command="{Binding Monitor.AbbrechenBefehl}"
                            Visibility="{Binding Monitor.Laeuft, Converter={StaticResource BoolNachSichtbar}}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Auto: die Breite steht am Rahmen, weil ColumnDefinition.Width
                     ein GridLength ist und das Token ein Double. -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Seitenleiste. Die Zeichen stammen aus Segoe MDL2 Assets;
                 dass jedes davon in BEIDEN Symbolschriften existiert, ist
                 gemessen und wird von DesignKanonTests festgehalten -
                 ein nur in Fluent vorhandenes Zeichen erschiene unter
                 Windows 10 still als Kaestchen. -->
            <Border Grid.Column="0" Width="{StaticResource breite-seitenleiste}"
                    Background="{StaticResource farbe-flaeche-2}"
                    BorderBrush="{StaticResource farbe-linie}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <RadioButton Style="{StaticResource BereichsSchalter}" IsChecked="True"
                                 Command="{Binding WechsleBefehl}" CommandParameter="{x:Static app:Bereich.Start}">
                        <StackPanel>
                            <TextBlock Text="&#xE80F;" Style="{StaticResource BereichsIcon}" />
                            <TextBlock Text="Start" Style="{StaticResource BereichsLabel}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource BereichsSchalter}"
                                 Command="{Binding WechsleBefehl}" CommandParameter="{x:Static app:Bereich.Klassenbildung}">
                        <StackPanel>
                            <TextBlock Text="&#xE716;" Style="{StaticResource BereichsIcon}" />
                            <TextBlock Text="Klassen" Style="{StaticResource BereichsLabel}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource BereichsSchalter}"
                                 Command="{Binding WechsleBefehl}" CommandParameter="{x:Static app:Bereich.Stundenplan}">
                        <StackPanel>
                            <TextBlock Text="&#xE787;" Style="{StaticResource BereichsIcon}" />
                            <TextBlock Text="Stunden" Style="{StaticResource BereichsLabel}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource BereichsSchalter}"
                                 Command="{Binding WechsleBefehl}" CommandParameter="{x:Static app:Bereich.Stammdaten}">
                        <StackPanel>
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource BereichsIcon}" />
                            <TextBlock Text="Stammdaten" Style="{StaticResource BereichsLabel}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource BereichsSchalter}"
                                 Command="{Binding WechsleBefehl}" CommandParameter="{x:Static app:Bereich.Regeln}">
                        <StackPanel>
                            <TextBlock Text="&#xE7C1;" Style="{StaticResource BereichsIcon}" />
                            <TextBlock Text="Regeln" Style="{StaticResource BereichsLabel}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource BereichsSchalter}"
                                 Command="{Binding WechsleBefehl}" CommandParameter="{x:Static app:Bereich.Laeufe}">
                        <StackPanel>
                            <TextBlock Text="&#xE768;" Style="{StaticResource BereichsIcon}" />
                            <TextBlock Text="Läufe" Style="{StaticResource BereichsLabel}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <!-- Das Dashboard: der bestehende Viewer, 1:1 gehostet,
                     randlos und über die volle Fläche
                     (Konzept 1, "Dashboard-first"). -->
                <wv2:WebView2 x:Name="Dashboard" Visibility="Collapsed" />

                <!-- Startseite als Schrittleiste (Konzept 8). Jeder
                     Schritt zeigt seinen echten Stand aus dem ViewModel -
                     Zeichen UND Farbe, damit er ohne Farbe lesbar
                     bleibt. -->
                <ScrollViewer x:Name="Startseite" Background="{StaticResource farbe-flaeche}">
                    <StackPanel Margin="{StaticResource pad-platte}" MaxWidth="780" HorizontalAlignment="Left">

                        <TextBlock Text="Schulplanung" Style="{StaticResource Marke}" />
                        <TextBlock Text="{Binding Titel}" Foreground="{StaticResource farbe-text-3}"
                                   FontSize="{StaticResource grad-basis}" Margin="0,2,0,24" />

                        <!-- [1] Projekt -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Style="{StaticResource SchrittZeichen}" DataContext="{Binding SchrittProjekt}" />
                            <TextBlock Text="Projekt" Style="{StaticResource SchrittTitel}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SchrittText}" Margin="26,2,0,8"
                                   Text="Ein neues Projekt anlegen oder einen bestehenden Schulordner im tests/&lt;schule&gt;/-Layout übernehmen." />
                        <StackPanel Orientation="Horizontal" Margin="26,0,0,24">
                            <Button Content="Neues Projekt…" Style="{StaticResource KnopfPrimaer}" Command="{Binding NeuBefehl}" />
                            <Button Content="Bestehende Schule übernehmen…" Margin="8,0,0,0" Command="{Binding ImportierenBefehl}" />
                            <Button Content="Öffnen…" Margin="8,0,0,0" Command="{Binding OeffnenBefehl}" />
                        </StackPanel>

                        <!-- [2] Stammdaten -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Style="{StaticResource SchrittZeichen}" DataContext="{Binding SchrittStammdaten}" />
                            <TextBlock Text="Stammdaten" Style="{StaticResource SchrittTitel}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SchrittText}" Margin="26,2,0,24"
                                   Text="{Binding SchrittStammdatenText}" />

                        <!-- [3] Rechnen -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Style="{StaticResource SchrittZeichen}" DataContext="{Binding SchrittRechnen}" />
                            <TextBlock Text="Klassenbildung rechnen" Style="{StaticResource SchrittTitel}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SchrittText}" Margin="26,2,0,8"
                                   Text="Varianten rechnen und im Board bewerten. Der Lauf läuft im Hintergrund und ist jederzeit abbrechbar – bereits fertige Varianten bleiben erhalten." />
                        <StackPanel Orientation="Horizontal" Margin="26,0,0,24">
                            <Button Content="Klassenbildung rechnen" Style="{StaticResource KnopfPrimaer}"
                                    Command="{Binding KlassenbildungBefehl}" />
                        </StackPanel>

                        <!-- Noch nicht umgesetzt: ehrlich als eigene
                             Schritte gezeigt statt als Fussnote, damit
                             die Leiste den ganzen Weg abbildet. -->
                        <Border BorderBrush="{StaticResource farbe-linie}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Style="{StaticResource SchrittZeichen}" />
                                    <TextBlock Text="Entscheiden" Style="{StaticResource SchrittTitel}"
                                               Foreground="{StaticResource farbe-text-3}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SchrittText}" Margin="26,2,0,12"
                                           Text="Stundenplan-Dashboard, Stammdaten- und Regel-Masken – noch nicht umgesetzt (Stufe F/G)." />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Style="{StaticResource SchrittZeichen}" />
                                    <TextBlock Text="Freigabe &amp; Export" Style="{StaticResource SchrittTitel}"
                                               Foreground="{StaticResource farbe-text-3}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SchrittText}" Margin="26,2,0,0"
                                           Text="Über den Bereich Läufe: Stand freigeben mit aktiver Bestätigung, danach geschützt gegen Löschen und Verdrängen. Klarnamen-Export folgt in Stufe G5." />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Bereich "Laeufe" (Konzept 6.13): die Historie der
                     gesicherten Staende. Der AKTIVE Lauf hat seine
                     Anzeige weiterhin in der Statusleiste - hier geht es
                     um das, was danach uebrig bleibt. -->
                <DockPanel x:Name="Laeufe" Visibility="Collapsed"
                           Background="{StaticResource farbe-flaeche}"
                           Margin="{StaticResource pad-platte}">
                    <TextBlock DockPanel.Dock="Top" Text="Läufe und Stände"
                               FontSize="{StaticResource grad-titel}" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Top" Margin="0,2,0,12" TextWrapping="Wrap"
                               MaxWidth="720" HorizontalAlignment="Left"
                               FontSize="{StaticResource grad-klein}"
                               Foreground="{StaticResource farbe-text-2}"
                               Text="Jeder Lauf hinterlässt einen Stand. Ältere werden verdrängt, sobald die Obergrenze erreicht ist – freigegebene und geschützte nie." />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="StandAnsehen" Content="Ansehen" Click="AufStandAnsehen"
                                Style="{StaticResource KnopfPrimaer}" />
                        <Button x:Name="StandUmbenennen" Content="Umbenennen…" Margin="8,0,0,0"
                                Click="AufStandUmbenennen" />
                        <Button x:Name="StandLoeschen" Content="Löschen" Margin="8,0,0,0"
                                Click="AufStandLoeschen" />
                        <Button x:Name="StandFreigeben" Content="Als Freigabe markieren…" Margin="24,0,0,0"
                                Click="AufStandFreigeben" />
                    </StackPanel>

                    <TextBlock x:Name="StandInfo" DockPanel.Dock="Bottom" Margin="0,10,0,0"
                               TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                               FontSize="{StaticResource grad-klein}"
                               Foreground="{StaticResource farbe-text-2}" />

                    <ListBox x:Name="Standliste" SelectionChanged="AufStandAuswahl"
                             BorderBrush="{StaticResource farbe-linie}" BorderThickness="1"
                             DisplayMemberPath="Anzeige" />
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
