<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:app="clr-namespace:TimetableGui"
        Title="{Binding Titel}" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource farbe-flaeche}"
        Foreground="{StaticResource farbe-text}"
        FontFamily="{StaticResource schrift-stapel}"
        FontSize="{StaticResource grad-basis}">

    <!-- Schrift und Grundfarben stehen HIER am Fenster, nicht als
         impliziter Style TargetType="Window": implizite Styles greifen
         auf den konkreten Typ, und MainWindow ist eine Ableitung -
         ein Window-Style wuerde sie stillschweigend verfehlen. Beide
         Eigenschaften vererben von hier nach unten und sind damit der
         billigste globale Hebel. -->

    <!-- Fensteraufbau (gui-ui-konzept.md 2, Stufe H): EIN Hauptfenster,
         schmale Seitenleiste mit vier Bereichen - Start, die zwei
         Rechnungen, Laeufe. Ueber jedem Dashboard ein Bereichskopf mit
         den Eingaben und dem Rechnen-Knopf dieser Rechnung; ohne
         Ergebnis zeigt der Bereich statt eines leeren WebView2 seinen
         Ablauf. Stammdaten- und Regel-Pflege laufen als modale Dialoge
         DARUEBER - das Dashboard bleibt der Anker. -->

    <Window.Resources>
        <!-- Eine Zeile eines Ablaufs: Zeichen UND Farbe fuer den Stand
             (lesbar ohne Farbe), Titel, eine Zeile Substanz. Ein Klick
             fuehrt die Aktion der Zeile aus - die steht am Objekt, nicht
             in einer Fallunterscheidung im Code-Behind. Dieselbe Vorlage
             fuer die Startkarten und die Leerseite eines Bereichs. -->
        <DataTemplate x:Key="SchrittZeile">
            <Button Style="{StaticResource Schrittknopf}" Click="AufSchrittAktion" Tag="{Binding}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SchrittZeichen}" DataContext="{Binding Stand}" />
                        <TextBlock Text="{Binding Nummer, StringFormat='[{0}]'}"
                                   Style="{StaticResource SchrittText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Titel}" Style="{StaticResource SchrittTitel}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Text}" Style="{StaticResource SchrittText}"
                               Margin="26,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Eine Karte der Startseite: der Ablauf einer Rechnung. Bewusst
             OHNE eigenen Knopf in den Bereich - die Zeile "Entscheiden"
             fuehrt dorthin, die Seitenleiste ebenfalls; ein dritter Weg
             hiess "Oeffnen" und stand direkt unter "Oeffnen…" (Datei),
             das etwas ganz anderes tut. -->
        <DataTemplate x:Key="Kartenvorlage">
            <Border Background="{StaticResource farbe-flaeche-2}"
                    BorderBrush="{StaticResource farbe-linie}" BorderThickness="1"
                    CornerRadius="{StaticResource radius-l}"
                    Padding="{StaticResource pad-platte}" Margin="0,0,16,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Titel}"
                               FontSize="{StaticResource grad-titel}" FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Zeilen}" ItemTemplate="{StaticResource SchrittZeile}" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- Menue (gui-ui-konzept.md 3): Datei fuer das Projekt,
             Bearbeiten fuer die Eingaben, Planung fuer Laeufe und
             Staende, Extras fuer das, was keiner Rechnung gehoert. Alle
             Eintraege haengen an Befehlen des ViewModels - Menue,
             Startkarte und Bereichskopf gehen damit denselben Weg. -->
        <Menu x:Name="Hauptmenue" DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="Neues Projekt…" Command="{Binding NeuBefehl}">
                    <MenuItem.Icon><TextBlock Text="&#xE8A5;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Bestehende Schule übernehmen…" Command="{Binding ImportierenBefehl}">
                    <MenuItem.Icon><TextBlock Text="&#xE8B5;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Öffnen…" Command="{Binding OeffnenBefehl}">
                    <MenuItem.Icon><TextBlock Text="&#xE8E5;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Speichern" InputGestureText="Strg+S" Command="{Binding SpeichernBefehl}">
                    <MenuItem.Icon><TextBlock Text="&#xE74E;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Speichern unter…" Command="{Binding SpeichernUnterBefehl}">
                    <MenuItem.Icon><TextBlock Text="&#xE792;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Projekt schließen" Command="{Binding SchliessenBefehl}">
                    <MenuItem.Icon><TextBlock Text="&#xE8BB;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Beenden" Click="AufBeenden">
                    <MenuItem.Icon><TextBlock Text="&#xE7E8;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Bearbeiten">
                <MenuItem Header="Stammdaten…" Command="{Binding StammdatenBefehl}">
                    <MenuItem.Icon><TextBlock Text="&#xE8FD;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Regeln…" Command="{Binding RegelnBefehl}">
                    <MenuItem.Icon><TextBlock Text="&#xE7C1;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Klassenbildung: Kinder &amp; Regeln…" Command="{Binding KlassenbildungEingabenBefehl}">
                    <MenuItem.Icon><TextBlock Text="&#xE716;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Solver-Einstellungen…" Command="{Binding SolverEinstellungenBefehl}">
                    <MenuItem.Icon><TextBlock Text="&#xE713;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Planung">
                <MenuItem Header="Klassenbildung rechnen" InputGestureText="F5" Command="{Binding KlassenbildungBefehl}">
                    <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Stundenplan rechnen" InputGestureText="F6" Command="{Binding StundenplanBefehl}">
                    <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Lauf abbrechen" Command="{Binding Monitor.AbbrechenBefehl}">
                    <MenuItem.Icon><TextBlock Text="&#xE71A;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Läufe und Stände" Command="{Binding WechsleBefehl}"
                          CommandParameter="{x:Static app:Bereich.Laeufe}">
                    <MenuItem.Icon><TextBlock Text="&#xE81C;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Extras">
                <MenuItem Header="Klarnamen exportieren…" Click="AufKlarnamenExport">
                    <MenuItem.Icon><TextBlock Text="&#xE7B8;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Browserdaten bereinigen" Click="AufBrowserdatenBereinigen">
                    <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Hilfe">
                <MenuItem Header="Über" Click="AufUeber">
                    <MenuItem.Icon><TextBlock Text="&#xE946;" Style="{StaticResource Menuesymbol}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Statusleiste: Meldung, laufender Lauf mit Kurzfortschritt und
             Abbrechen (Konzept 2). -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Meldung}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Monitor.StatusZeile}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ProgressBar Width="140" Height="6" Minimum="0" Maximum="100"
                                 VerticalAlignment="Center"
                                 Background="{StaticResource farbe-linie}"
                                 Foreground="{StaticResource farbe-akzent}"
                                 BorderThickness="0"
                                 Value="{Binding Monitor.FortschrittProzent, Mode=OneWay}"
                                 Visibility="{Binding Monitor.Laeuft, Converter={StaticResource BoolNachSichtbar}}" />
                    <Button Content="Abbrechen" Margin="8,0,0,0" MinHeight="22" MinWidth="0" Padding="8,2"
                            Command="{Binding Monitor.AbbrechenBefehl}"
                            Visibility="{Binding Monitor.Laeuft, Converter={StaticResource BoolNachSichtbar}}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Auto: die Breite steht am Rahmen, weil ColumnDefinition.Width
                     ein GridLength ist und das Token ein Double. -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Seitenleiste. Die Zeichen stammen aus Segoe MDL2 Assets;
                 dass jedes davon in BEIDEN Symbolschriften existiert, ist
                 gemessen und wird von DesignKanonTests festgehalten -
                 ein nur in Fluent vorhandenes Zeichen erschiene unter
                 Windows 10 still als Kaestchen.

                 IsChecked haengt ZWEISEITIG am Bereich: der Wechsel kann
                 auch vom Modell kommen (F5 aus der Startseite, "Ansehen"
                 aus den Laeufen), und vorher blieb die Markierung dann
                 auf dem alten Eintrag stehen. -->
            <Border Grid.Column="0" Width="{StaticResource breite-seitenleiste}"
                    Background="{StaticResource farbe-flaeche-2}"
                    BorderBrush="{StaticResource farbe-linie}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <RadioButton x:Name="SchalterStart" Style="{StaticResource BereichsSchalter}"
                                 IsChecked="{Binding Bereich, Mode=TwoWay, Converter={StaticResource BereichGewaehlt}, ConverterParameter={x:Static app:Bereich.Start}}">
                        <StackPanel>
                            <TextBlock Text="&#xE80F;" Style="{StaticResource BereichsIcon}" />
                            <TextBlock Text="Start" Style="{StaticResource BereichsLabel}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SchalterKlassenbildung" Style="{StaticResource BereichsSchalter}"
                                 IsChecked="{Binding Bereich, Mode=TwoWay, Converter={StaticResource BereichGewaehlt}, ConverterParameter={x:Static app:Bereich.Klassenbildung}}">
                        <StackPanel>
                            <TextBlock Text="&#xE716;" Style="{StaticResource BereichsIcon}" />
                            <TextBlock Text="Klassen" Style="{StaticResource BereichsLabel}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SchalterStundenplan" Style="{StaticResource BereichsSchalter}"
                                 IsChecked="{Binding Bereich, Mode=TwoWay, Converter={StaticResource BereichGewaehlt}, ConverterParameter={x:Static app:Bereich.Stundenplan}}">
                        <StackPanel>
                            <TextBlock Text="&#xE787;" Style="{StaticResource BereichsIcon}" />
                            <TextBlock Text="Stunden" Style="{StaticResource BereichsLabel}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SchalterLaeufe" Style="{StaticResource BereichsSchalter}"
                                 IsChecked="{Binding Bereich, Mode=TwoWay, Converter={StaticResource BereichGewaehlt}, ConverterParameter={x:Static app:Bereich.Laeufe}}">
                        <StackPanel>
                            <TextBlock Text="&#xE768;" Style="{StaticResource BereichsIcon}" />
                            <TextBlock Text="Läufe" Style="{StaticResource BereichsLabel}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <DockPanel Grid.Column="1">

                <!-- Bereichskopf der aktiven Rechnung: ihre Eingaben als
                     Zeilen mit Stand, der Rechnen-Knopf, rechts der
                     Stand-Wechsler. Freigeben steht NICHT hier - das hat
                     die Aktionsleiste im Viewer bereits, und ohne Stand
                     gibt es nichts freizugeben. -->
                <Border x:Name="Bereichskopf" DockPanel.Dock="Top" Visibility="Collapsed"
                        Background="{StaticResource farbe-flaeche-2}"
                        BorderBrush="{StaticResource farbe-linie}" BorderThickness="0,0,0,1"
                        Padding="12,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Stand" VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontSize="{StaticResource grad-klein}"
                                       Foreground="{StaticResource farbe-text-2}" />
                            <ComboBox x:Name="Standwahl" MinWidth="280" VerticalAlignment="Center"
                                      DisplayMemberPath="Anzeige" SelectionChanged="AufStandwahl"
                                      ToolTip="Einen gesicherten Stand dieser Rechnung anzeigen" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Kopftitel" VerticalAlignment="Center" Margin="0,0,16,0"
                                       FontSize="{StaticResource grad-kopf}" FontWeight="SemiBold" />
                            <ItemsControl x:Name="Kopfzeilen" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Kopfknopf}" Click="AufSchrittAktion"
                                                Tag="{Binding}" ToolTip="{Binding Text}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SchrittZeichen}" DataContext="{Binding Stand}" />
                                                <TextBlock Text="{Binding Titel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="KopfRechnen" Style="{StaticResource KnopfPrimaer}"
                                    Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <!-- Das Dashboard: der bestehende Viewer, 1:1 gehostet,
                         randlos und über die volle Fläche
                         (Konzept 1, "Dashboard-first"). -->
                    <wv2:WebView2 x:Name="Dashboard" Visibility="Collapsed" />

                    <!-- Die Leerseite eines Bereichs: solange kein Ergebnis
                         da ist, steht hier der Ablauf der Rechnung - dieselben
                         Zeilen wie auf der Startkarte. -->
                    <ScrollViewer x:Name="Leerseite" Visibility="Collapsed"
                                  Background="{StaticResource farbe-flaeche}">
                        <StackPanel Margin="{StaticResource pad-platte}" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock x:Name="LeerTitel" Style="{StaticResource Marke}" />
                            <TextBlock Text="Noch kein Ergebnis. So geht es weiter:"
                                       Foreground="{StaticResource farbe-text-2}" Margin="0,2,0,16" />
                            <ItemsControl x:Name="Leerzeilen" ItemTemplate="{StaticResource SchrittZeile}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Startseite (Konzept 8, Stufe H): Einstieg und je
                         Rechnung eine Karte mit ihrem Ablauf. Der Einstieg
                         steht ÜBER den Karten und ist keine Zeile - die
                         Karten setzen ein offenes Projekt voraus. -->
                    <ScrollViewer x:Name="Startseite" Background="{StaticResource farbe-flaeche}">
                        <StackPanel Margin="{StaticResource pad-platte}" MaxWidth="1100" HorizontalAlignment="Left">

                            <TextBlock Text="Schulplanung" Style="{StaticResource Marke}" />
                            <TextBlock Text="{Binding Titel}" Foreground="{StaticResource farbe-text-3}"
                                       FontSize="{StaticResource grad-basis}" Margin="0,2,0,20" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Content="Neues Projekt…" Style="{StaticResource KnopfPrimaer}" Command="{Binding NeuBefehl}" />
                                <Button Content="Bestehende Schule übernehmen…" Margin="8,0,0,0" Command="{Binding ImportierenBefehl}" />
                                <Button Content="Öffnen…" Margin="8,0,0,0" Command="{Binding OeffnenBefehl}" />
                            </StackPanel>

                            <ItemsControl x:Name="Startkarten" ItemTemplate="{StaticResource Kartenvorlage}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bereich "Laeufe" (Konzept 6.13): die Historie der
                         gesicherten Staende. Der AKTIVE Lauf hat seine
                         Anzeige weiterhin in der Statusleiste - hier geht es
                         um das, was danach uebrig bleibt. -->
                    <DockPanel x:Name="Laeufe" Visibility="Collapsed"
                               Background="{StaticResource farbe-flaeche}"
                               Margin="{StaticResource pad-platte}">
                        <TextBlock DockPanel.Dock="Top" Text="Läufe und Stände"
                                   FontSize="{StaticResource grad-titel}" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Margin="0,2,0,12" TextWrapping="Wrap"
                                   MaxWidth="720" HorizontalAlignment="Left"
                                   FontSize="{StaticResource grad-klein}"
                                   Foreground="{StaticResource farbe-text-2}"
                                   Text="Jeder Lauf hinterlässt einen Stand. Ältere werden verdrängt, sobald die Obergrenze erreicht ist – freigegebene und geschützte nie." />

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="StandAnsehen" Content="Ansehen" Click="AufStandAnsehen"
                                    Style="{StaticResource KnopfPrimaer}" />
                            <Button x:Name="StandUmbenennen" Content="Umbenennen…" Margin="8,0,0,0"
                                    Click="AufStandUmbenennen" />
                            <Button x:Name="StandLoeschen" Content="Löschen" Margin="8,0,0,0"
                                    Click="AufStandLoeschen" />
                            <Button x:Name="StandFreigeben" Content="Als Freigabe markieren…" Margin="24,0,0,0"
                                    Click="AufStandFreigeben" />
                        </StackPanel>

                        <TextBlock x:Name="StandInfo" DockPanel.Dock="Bottom" Margin="0,10,0,0"
                                   TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                                   FontSize="{StaticResource grad-klein}"
                                   Foreground="{StaticResource farbe-text-2}" />

                        <ListBox x:Name="Standliste" SelectionChanged="AufStandAuswahl"
                                 BorderBrush="{StaticResource farbe-linie}" BorderThickness="1"
                                 DisplayMemberPath="Anzeige" />
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
