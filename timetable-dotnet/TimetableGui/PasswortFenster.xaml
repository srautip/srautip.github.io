<Window x:Class="PasswortFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Passwort" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource farbe-flaeche}"
        Foreground="{StaticResource farbe-text}"
        FontFamily="{StaticResource schrift-stapel}"
        FontSize="{StaticResource grad-basis}">
    <StackPanel Margin="{StaticResource pad-platte}">
        <TextBlock x:Name="Titelzeile" TextWrapping="Wrap" Margin="0,0,0,16"
                   FontSize="{StaticResource grad-kopf}" />

        <TextBlock Text="Passwort" Foreground="{StaticResource farbe-text-2}" />
        <PasswordBox x:Name="Feld" Margin="0,4,0,12" />

        <StackPanel x:Name="WiederholungsBlock">
            <TextBlock Text="Passwort wiederholen" Foreground="{StaticResource farbe-text-2}" />
            <PasswordBox x:Name="Wiederholung" Margin="0,4,0,12" />
            <!-- Beim Anlegen: ohne diesen Hinweis waere die Tragweite
                 nicht erkennbar - es gibt bewusst keinen Recovery-Weg
                 (arc42 8.12). Deshalb als Warnflaeche und nicht als
                 blass gestellter Nebensatz. -->
            <Border Background="{StaticResource farbe-warn-flaeche}"
                    BorderBrush="{StaticResource farbe-warn-rand}" BorderThickness="1"
                    CornerRadius="{StaticResource radius-m}"
                    Padding="12,8" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource schrift-symbole}"
                               Foreground="{StaticResource farbe-warn-text}"
                               FontSize="{StaticResource grad-kopf}" Margin="0,0,10,0"
                               VerticalAlignment="Top" />
                    <TextBlock TextWrapping="Wrap" MaxWidth="330"
                               Foreground="{StaticResource farbe-text-2}"
                               Text="Ohne dieses Passwort sind die Daten nicht wiederherstellbar. Es gibt keinen Ersatzschlüssel." />
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock x:Name="Fehler" Foreground="{StaticResource farbe-krit-text}"
                   TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" IsCancel="True" />
            <Button Content="OK" IsDefault="True" Margin="8,0,0,0"
                    Style="{StaticResource KnopfPrimaer}" Click="AufOk" />
        </StackPanel>
    </StackPanel>
</Window>
