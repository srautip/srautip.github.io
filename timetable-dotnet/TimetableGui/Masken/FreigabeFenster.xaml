<Window x:Class="FreigabeFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Freigabe" Height="700" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource farbe-flaeche}"
        Foreground="{StaticResource farbe-text}"
        FontFamily="{StaticResource schrift-stapel}"
        FontSize="{StaticResource grad-basis}">

    <!-- Freigabe (klassenbildung-konzept.md 10.1). Art. 22 DSGVO verlangt
         den NACHWEIS einer echten menschlichen Pruefung - "ein blosser
         OK-Klick ohne angezeigte Abweichungen waere als menschliche
         Beteiligung angreifbar".

         Deshalb ist dieses Fenster so gebaut, wie es gebaut ist: die
         Abweichungen stehen OBEN und nehmen den meisten Platz ein, der
         Bestaetigungssatz nennt ihre Zahl, und der Knopf bleibt aus,
         solange Haken oder Name fehlen. Das ist kein Gaengeln, sondern
         die Form, in der die Bestaetigung ueberhaupt etwas wert ist. -->

    <DockPanel Margin="{StaticResource pad-platte}">

        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0"
                BorderBrush="{StaticResource farbe-linie}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" IsCancel="True" />
                <Button x:Name="FreigebenKnopf" Content="Freigeben" Margin="8,0,0,0"
                        IsEnabled="False" Style="{StaticResource KnopfPrimaer}" Click="AufFreigeben" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Kopf" FontSize="{StaticResource grad-titel}" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="Kennzahlen" Margin="0,2,0,0" TextWrapping="Wrap"
                       FontSize="{StaticResource grad-klein}"
                       Foreground="{StaticResource farbe-text-2}" />
            <TextBlock x:Name="Abweichungskopf" Margin="0,16,0,4" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Border x:Name="Satzrahmen" Padding="10"
                    BorderBrush="{StaticResource farbe-linie-stark}" BorderThickness="1"
                    CornerRadius="{StaticResource radius-m}"
                    Background="{StaticResource farbe-flaeche-2}">
                <CheckBox x:Name="Haken" Click="AufEingabe" VerticalContentAlignment="Center">
                    <TextBlock x:Name="Satz" TextWrapping="Wrap" MaxWidth="580" />
                </CheckBox>
            </Border>
            <StackPanel Margin="0,14,0,0">
                <TextBlock x:Name="Notizfrage" TextWrapping="Wrap" MaxWidth="640"
                           HorizontalAlignment="Left" FontWeight="SemiBold" />
                <TextBox x:Name="NotizFeld" Margin="0,4,0,0" Height="64"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" TextChanged="AufEingabe" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                           FontSize="{StaticResource grad-klein}"
                           Foreground="{StaticResource farbe-text-3}"
                           Text="Diese Begründung wird wörtlich ins Protokoll übernommen und bleibt dort. Sie ist der Beleg, dass die Abweichungen abgewogen wurden – ein Häkchen allein wäre es nicht. Keine Namen Dritter oder Gesundheitsangaben eintragen; die Regelbezeichnungen oben genügen." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="Name der freigebenden Person" VerticalAlignment="Center"
                           Foreground="{StaticResource farbe-text-2}" />
                <TextBox x:Name="PersonFeld" Width="260" Margin="12,0,0,0" TextChanged="AufEingabe" />
            </StackPanel>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                       FontSize="{StaticResource grad-klein}"
                       Foreground="{StaticResource farbe-text-3}"
                       Text="Name, Zeitpunkt und die oben gezeigten Abweichungen werden im Projekt protokolliert. Der freigegebene Stand ist danach gegen Löschen und Verdrängen geschützt." />
        </StackPanel>

        <Border BorderBrush="{StaticResource farbe-linie}" BorderThickness="1"
                CornerRadius="{StaticResource radius-m}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Abweichungen" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
