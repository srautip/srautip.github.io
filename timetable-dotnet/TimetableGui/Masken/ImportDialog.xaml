<Window x:Class="ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import: Spalten zuordnen" Height="640" Width="940"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource farbe-flaeche}"
        Foreground="{StaticResource farbe-text}"
        FontFamily="{StaticResource schrift-stapel}"
        FontSize="{StaticResource grad-basis}">

    <!-- Spalten-Zuordnung (gui-ui-konzept.md 9.1). Die Vorgabe je Spalte
         ist VERWERFEN: eine Klassenliste aus dem Sekretariat trägt
         Telefonnummern und Geburtsdaten, die hier nichts zu suchen
         haben. Datenminimierung heißt, dass man Übernehmen anklickt,
         nicht Weglassen. -->

    <DockPanel Margin="{StaticResource pad-platte}">

        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0"
                BorderBrush="{StaticResource farbe-linie}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Abbrechen" IsCancel="True" />
                    <Button x:Name="UebernehmenKnopf" Content="Übernehmen" Margin="8,0,0,0"
                            Style="{StaticResource KnopfPrimaer}" Click="AufUebernehmen" />
                </StackPanel>
                <TextBlock x:Name="Befund" VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="560" HorizontalAlignment="Left"
                           FontSize="{StaticResource grad-klein}" />
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Kopfzeile" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="620" />
                <Button x:Name="DateiKnopf" Content="Aus CSV-Datei…" Margin="16,0,0,0" Click="AufDatei" />
            </StackPanel>
            <CheckBox x:Name="HatKopfzeile" Content="Erste Zeile ist eine Spaltenüberschrift"
                      Margin="0,10,0,0" Click="AufKopfzeile" />
            <TextBlock Text="Eine falsch verworfene erste Zeile ist ein verlorenes Kind – bitte prüfen."
                       Margin="0,2,0,10" FontSize="{StaticResource grad-klein}"
                       Foreground="{StaticResource farbe-text-3}" />
            <TextBlock Text="Zuordnung je Spalte" FontWeight="SemiBold" Margin="0,4,0,2" />
            <TextBlock TextWrapping="Wrap" MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,0,8"
                       FontSize="{StaticResource grad-klein}"
                       Foreground="{StaticResource farbe-text-3}"
                       Text="Nicht zugeordnete Spalten werden verworfen – das ist die Vorgabe. Attribute stehen namentlich in der Liste; führt das Projekt schon eines, wählt man es dort und legt kein zweites an. Zu einem Attribut kann gleich die passende Regel entstehen: bei zwei Ausprägungen (ja/nein, m/w) eine Balance, bei einer Werteliste (Kitas) je Wert eine Bündelung „Attribut_Wert“. „Gruppe“ legt je vorkommendem Wert eine Verteilungsgruppe an (Spalte „Religion“ mit ev/kath/ethik ergibt drei). „Klasse“ übernimmt eine bestehende Einteilung als Fixierung." />
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Zuordnung" />
            </ScrollViewer>
        </StackPanel>

        <Border Margin="0,12,0,0" BorderBrush="{StaticResource farbe-linie}" BorderThickness="1"
                CornerRadius="{StaticResource radius-m}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="Tabelle" Margin="8" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
