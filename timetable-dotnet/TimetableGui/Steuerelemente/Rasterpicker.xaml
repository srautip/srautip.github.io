<UserControl x:Class="Rasterpicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource schrift-stapel}"
             FontSize="{StaticResource grad-klein}">
    <!-- Das gemeinsame Tag-x-Stunde-Gitter (gui-ui-konzept.md 6.10).
         Bewusst DUENN: die Auswahllogik liegt in RasterAuswahl und ist
         dort ohne Fenster geprueft - hier steht nur Anzeige und
         Eingabe.

         Das Gitter selbst wird im Code-Behind aufgebaut, nicht per
         ItemsControl: es ist zweidimensional und seine Groesse steht
         erst zur Laufzeit fest (aus `tage`/`periods_per_day` der
         Schuldaten). Eine Schachtelung aus ItemsControls waere hier
         mehr Mechanik als Gewinn.

         Optik nach derselben Regel wie die Stundentafel - "damit 'wo'
         immer gleich aussieht" (6.10). Beide lesen dieselben Token. -->
    <StackPanel>
        <Border BorderBrush="{StaticResource farbe-linie}" BorderThickness="1"
                CornerRadius="{StaticResource radius-m}"
                Background="{StaticResource farbe-flaeche}">
            <Grid x:Name="Gitter" Margin="1" />
        </Border>
        <TextBlock x:Name="Zusammenfassung"
                   Margin="0,6,0,0"
                   FontSize="{StaticResource grad-mikro}"
                   Foreground="{StaticResource farbe-text-2}" />
    </StackPanel>
</UserControl>
