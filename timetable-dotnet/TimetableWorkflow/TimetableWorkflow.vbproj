<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TimetableWorkflow</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimetableCore\TimetableCore.vbproj" />
    <ProjectReference Include="..\TimetableYaml\TimetableYaml.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="TimetableCore" />
    <Import Include="TimetableYaml" />
  </ItemGroup>

  <!-- Phase 2.21: die Viewer-Vorlagen werden als Ressource in die Assembly
       eingebettet (statt per CopyToOutputDirectory kopiert), damit sie zur
       Laufzeit unabhaengig vom Arbeitsverzeichnis ueber
       Assembly.GetManifestResourceStream lesbar sind. WICHTIG: SDK-style
       VB-Projekte nehmen den Ordner "Templates\" NICHT in den logischen
       Ressourcennamen auf - er lautet "TimetableWorkflow.stundentafel.html".
       Beim Verschieben zwischen Projekten muessen deshalb IMMER die
       ResourceName-Konstanten mitgezogen werden. -->
  <ItemGroup>
    <EmbeddedResource Include="Templates\stundentafel.html" />
    <EmbeddedResource Include="Templates\klassenbildung.html" />
    <!-- Die Designsystem-Quelle. Eingebettet, damit die Waechtertests
         sie ohne Pfadwissen lesen koennen; der logische Name lautet
         nach derselben Regel wie oben "TimetableWorkflow.design-tokens.css".
         Sie wird NICHT zur Laufzeit injiziert - die Vorlagen tragen
         eine zeichengleiche Kopie (siehe Kopf der CSS-Datei). -->
    <EmbeddedResource Include="Templates\design-tokens.css" />
    <EmbeddedResource Include="Templates\design-basis.css" />
  </ItemGroup>

</Project>
