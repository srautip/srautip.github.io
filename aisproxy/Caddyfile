# TLS besorgt sich Caddy selbst, sobald AIS_DOMAIN ein echter Name ist.
{$AIS_DOMAIN} {
	encode gzip

	# WICHTIG, sonst funktioniert der Browser-Client nicht:
	#
	# Ein Browser kann bei einem WebSocket KEINE Header setzen - die
	# WebSocket-Schnittstelle nimmt nur URL und Protokolle entgegen. Basic-Auth
	# ist damit fuer /v1/live grundsaetzlich nicht erfuellbar; Caddy antwortete
	# mit 401, bevor der Upgrade ueberhaupt beim Proxy ankommt. Eingebettete
	# Zugangsdaten in der URL (wss://benutzer:pass@host/) sind veraltet und
	# werden von den Browsern verworfen.
	#
	# Die Schnittstelle schuetzt deshalb das Token des Proxys selbst
	# (AIS_ZUGANG, als ?token= oder Bearer-Header) - das kann der Client
	# mitschicken. Basic-Auth bleibt fuer das, was ein Mensch im Browser
	# aufruft.
	@schnittstelle path /v1/live* /v1/snapshot* /v1/replay* /v1/track* /v1/ship/* /v1/foto/*
	handle @schnittstelle {
		reverse_proxy proxy:8080
	}

	handle {
		basic_auth {
			{$AIS_BENUTZER} {$AIS_PASSWORT_HASH}
		}
		reverse_proxy proxy:8080
	}

	log {
		output file /data/zugriff.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
