# Kopieren nach .env und ausfuellen. docker compose liest es von selbst.

# Der Name, unter dem der Proxy erreichbar ist. Caddy besorgt sich dafuer
# selbst ein Zertifikat, sobald hier ein echter Name steht.
AIS_DOMAIN=ais.example.org

# Basic-Auth fuer den kleinen Kreis. Hash erzeugen mit:
#   docker run --rm caddy:2-alpine caddy hash-password
AIS_BENUTZER=skipper
AIS_PASSWORT_HASH=

# Zusaetzliches Token direkt am Proxy (schuetzt auch den nackten Port).
# Leer lassen, wenn Caddy allein reichen soll.
AIS_ZUGANG=

# Leer lassen: Der Proxy holt sich beim Start selbst einen openwaters-Token.
AIS_TOKEN=
