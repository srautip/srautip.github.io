# Kopieren nach .env und ausfuellen. docker compose liest es von selbst.

# Der Name, unter dem der Proxy erreichbar ist. Caddy besorgt sich dafuer
# selbst ein Zertifikat, sobald hier ein echter Name steht.
AIS_DOMAIN=ais.example.org

# Basic-Auth fuer den kleinen Kreis. Hash erzeugen mit:
#   docker run --rm caddy:2-alpine caddy hash-password
AIS_BENUTZER=skipper
AIS_PASSWORT_HASH=

# Zusaetzliches Token direkt am Proxy (schuetzt auch den nackten Port).
# Leer lassen, wenn Caddy allein reichen soll.
AIS_ZUGANG=

# Leer lassen: Der Proxy holt sich beim Start selbst einen openwaters-Token.
AIS_TOKEN=

# Zugaenge fuer die 3D-Ansicht (aisstream/3d/). Hier hinterlegt, damit sie
# nicht in jedem Browser einzeln eingetragen werden muessen.
#
# ACHTUNG, das ist KEIN Geheimnis: Der Proxy gibt sie ueber
# /v1/einstellungen an jeden heraus, der das Proxy-Token hat - und das steht
# oeffentlich im Client. Der Gewinn ist EINE Stelle zum Wechseln. Deshalb
# einen ion-Token nehmen, der nur lesen darf und nur die benoetigten Assets
# kennt (2 Luftbild, 1 Gelaende, 96188 Gebaeude, 2275207 photorealistisch).
AIS_ION_TOKEN=
AIS_GOOGLE_KEY=
